# Root example for local development. Copy relevant values into backend/.env and frontend/.env.
# Do not commit real secrets.

# Backend (backend/.env)
GROQ_API_KEY=
NASA_API_KEY=
TTS_PROVIDER=edge
MOLA_DEM_PATH=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MOLA_SOURCE_URL=https://pds-geosciences.wustl.edu/mgs/urn-nasa-pds-mgs_mola_topography_derived/
TREK_IMAGERY_BASE_URL=https://trek.nasa.gov/mars/
TREK_TILE_BASE_URL=https://trek.nasa.gov/tiles/Mars/EQ
TREK_VIKING_IMAGERY_PATH=Mars_Viking_MDIM21_ClrMosaic_global_232m/1.0.0/default/default028mm/
MSL_SOURCE_URL=https://science.nasa.gov/mission/msl-curiosity/
M2020_SOURCE_URL=https://science.nasa.gov/mission/mars-2020-perseverance/
GAZETTEER_URL=https://planetarynames.wr.usgs.gov/
REMS_URL=https://mars.nasa.gov/rss/api/?feed=weather&category=msl&feedtype=json
REMS_USER_AGENT=ASTRA/0.1 (NASA Space Apps)
BOXWORK_SOURCE_URL=https://science.nasa.gov/photojournal/curiosity-views-boxwork-patterns-at-a-distance/
BOXWORK_IMAGE_URL=https://assets.science.nasa.gov/content/dam/science/psd/photojournal/pia/pia26/pia26560/PIA26560.jpg
RAD_SOURCE_URL=https://science.nasa.gov/mission/msl-curiosity/science-instruments/

# Frontend (frontend/.env)
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_WS_PROXY_TARGET=ws://localhost:8000
VITE_TREK_TILE_BASE_URL=https://trek.nasa.gov/tiles/Mars/EQ
VITE_TREK_IMAGERY_BASE_URL=https://trek.nasa.gov/mars/
VITE_NASA_JET_DRILL_URL=https://images.nasa.gov/details/PIA22587
