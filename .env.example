# Copy to backend/.env and fill in values. Never commit real keys.

# --- Backend ---
GROQ_API_KEY=
NASA_API_KEY=

# TTS adapter: edge | local_qwen | kokoro
TTS_PROVIDER=edge

# Optional: override the MOLA 16 ppd DEM path
# Default: backend/data/dem/megt90n000eb.img
MOLA_DEM_PATH=

# --- Frontend (optional, Vite dev proxy handles /api and /ws by default) ---
VITE_API_BASE=http://localhost:8000
